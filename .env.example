# ==============================================================================
# JobPilot - Environment Variables Template
#
# INSTRUCTIONS:
# 1. Copy this file to .env or workspace-specific .env files for local dev.
# 2. NEVER commit actual .env files, credentials, or API keys into git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Client-Safe / Renderer Variables (Vite prefixed, safe for desktop/web UI)
# ------------------------------------------------------------------------------
# Supabase Project URL (e.g. https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anonymous Key (safe for client-side authentication requests)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Application Environment (development | staging | production)
VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# 2. Server-Only Variables (Used by services/api - NEVER expose to renderer)
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 2. Server / Database Connection (Server-only / Migrations)
# ------------------------------------------------------------------------------
# Replace [YOUR-PASSWORD] with your actual DB password (URL-encoded if it has special characters)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Port for the Node.js API service
PORT=3001

# Node execution environment
NODE_ENV=development

# API Service URL for health/diagnostics
API_BASE_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 3. Desktop-Local Configuration (Used by Electron main process)
# ------------------------------------------------------------------------------
# Desktop process log level (debug | info | warn | error)
DESKTOP_LOG_LEVEL=info
